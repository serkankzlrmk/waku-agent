__pycache__/
*.pyc
.venv/
.env
state.db
traces/
*.ics
.DS_Store
dist/
.pytest_cache/
.ruff_cache/
.waku/
.waku.bak-*/
.waku.prerename-bak/
# Any ALTERNATE agent home, not just the default one. DISCORD_HOME gives the
# bot its own memory (see waku/gateway/discord.py); WAKU_HOME can point anywhere.
# Without this glob only `.waku/` was covered, so a second home's SOUL.md,
# usage.jsonl and outbox/ were tracked — the exact files you least want pushed.
.waku-*/
.env.prerename-bak

# Delegated coding deliverables (dated run folders + auto-run logs)
waku_workspace/

# Google OAuth: the client file you download from Cloud Console, and any token
# it produces. Nothing here should ever be committed — belt and braces, because
# the docs used to tell people to drop credentials.json in the repo root.
credentials.json
client_secret*.json
*token*.json

# Hermes plan-mode scratch files
.zcode/
.gcp/

# ─────────────────────────────────────────────────────────────
# KIŞISEL VERI KORUMASI — bu repo bir kişisel asistan çalıştırıyor.
# .waku/ (ana home) yukarıda kapalı. Bu bölüm İKİNCİ KATMAN: home
# WAKU_HOME ile başka bir yere taşınırsa, dosyalar repo köküne düşerse,
# veya biri yanlışlıkla `git add .` yaparsa kişisel veri asla dışarı çıkmasın.
# Kural: şüphedeysen TUTMA. GitHub'a giden her byte tekrar geri alınamaz.
# -----------------------------------------------------------------

# SQLite veritabanları (state.db, calendar.db, ne ad verirsen ver)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Asistanın hafızası ve kimliği — SOUL/MEMORY repo köküne kopyalanırsa
SOUL.md
MEMORY.md

# Kullanım/analiz kayıtları (hangi model, kaç token, kaç dolar — harcama
# geçmişi kişiseldir)
usage.jsonl
eval_runs.jsonl
eval_report.json

# Bağlantı sağlık durumu (hangi servise hangi key'le bağlıyız)
connections_health.json

# Mesaj kuyruğu (outbox) — gönderilecek/gönderilmiş mesajlar
outbox/

# Takvim dosyaları (herhangi bir isimle, herhangi bir dizinde)
*.ics
calendar.ics

# MCP bağlantı yapılandırması — server adları ve argümanları yerel kalmalı
mcp.json

# Binary artifacts & large models
*.apk
models/
window_dump.xml
